# Django Settings
DJANGO_SETTINGS_MODULE=backend.settings
SECRET_KEY=change-me-to-secure-random-key
DEBUG=0
ALLOWED_HOSTS=data.goholiday.id,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://data.goholiday.id,https://www.goholiday.id

# Database Configuration
DATABASE_URL=postgres://your-db-username:your-db-password@db:5432/travel_marketplace

SQL_ENGINE=django.db.backends.postgresql
SQL_DATABASE=travel_marketplace
SQL_USER=your-db-username
SQL_PASSWORD=your-db-password
SQL_HOST=db
SQL_PORT=5432
DB_CONN_MAX_AGE=300

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://www.goholiday.id,https://goholiday.id
CORS_ALLOW_CREDENTIALS=true

# JWT Token Configuration
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=30

# Email Configuration
# Production: set RESEND_API_KEY after domain verification in Resend dashboard.
# Until then, leave RESEND_API_KEY unset and keep existing MAILGUN_* vars — auto mode
# will continue using Mailgun with no code or env changes beyond this deploy.
EMAIL_PROVIDER=auto

# Resend HTTP API (recommended)
# RESEND_API_KEY=re_your-resend-api-key
RESEND_SENDING_DOMAIN=notifications.goholiday.id
# RESEND_SIGNING_SECRET=whsec_your-signing-secret

# Mailgun HTTP API (legacy fallback — remove after Resend cutover)
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=goholiday.id
# MAILGUN_API_URL=https://api.eu.mailgun.net/v3

DEFAULT_FROM_EMAIL=noreply@notifications.goholiday.id
FRONTEND_URL=https://www.goholiday.id

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Redis Cache Configuration
REDIS_URL=redis://redis:6379/1

# Security Settings (Production)
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true