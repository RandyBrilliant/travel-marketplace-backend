# Django Settings
DJANGO_SETTINGS_MODULE=backend.settings
SECRET_KEY=change-me-to-secure-random-key
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=localhost,127.0.0.1

# Database Configuration
DATABASE_URL=postgres://your-db-username:your-db-password@db:5432/travel_marketplace

SQL_ENGINE=django.db.backends.postgresql
SQL_DATABASE=travel_marketplace
SQL_USER=your-db-username
SQL_PASSWORD=your-db-password
SQL_HOST=db
SQL_PORT=5432
DB_CONN_MAX_AGE=300

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=true

# JWT Token Configuration
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=30

# Email Configuration
# Provider: auto (default) | resend | mailgun | smtp
# auto picks Resend if RESEND_API_KEY is set, else Mailgun HTTP API, else SMTP.
EMAIL_PROVIDER=auto

# Option 1: Resend HTTP API (recommended)
RESEND_API_KEY=re_your-resend-api-key
# Verified sending domain in Resend dashboard
RESEND_SENDING_DOMAIN=notifications.goholiday.id
# Optional: webhook signing secret for delivery tracking
# RESEND_SIGNING_SECRET=whsec_your-signing-secret

# Option 2: Mailgun HTTP API (legacy — kept until Resend migration is complete)
# MAILGUN_API_KEY=your-mailgun-api-key
# MAILGUN_DOMAIN=goholiday.id
# MAILGUN_API_URL=https://api.eu.mailgun.net/v3

# Option 3: SMTP (may be blocked by firewall — prefer HTTP API providers)
# MAILGUN_SMTP_SERVER=smtp.mailgun.org
# MAILGUN_SMTP_PORT=587
# MAILGUN_SMTP_LOGIN=your-mailgun-smtp-login
# MAILGUN_SMTP_PASSWORD=your-mailgun-smtp-password

DEFAULT_FROM_EMAIL=noreply@notifications.goholiday.id
FRONTEND_URL=http://localhost:3000

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Redis Cache Configuration
REDIS_URL=redis://redis:6379/1

# Security Settings (Production)
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false